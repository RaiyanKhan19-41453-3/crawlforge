# Copy to .env for local docker compose runs. Never commit real credentials.
SCRAPER_MAX_THREADS=4
SCRAPER_DB_URL=jdbc:postgresql://postgres:5432/crawlforge
SCRAPER_DB_USER=crawlforge
SCRAPER_DB_PASSWORD=change-me

# PostgreSQL service (keep in sync with SCRAPER_DB_* above)
POSTGRES_DB=crawlforge
POSTGRES_USER=crawlforge
POSTGRES_PASSWORD=change-me

# Optional site login credentials (kept out of committed JSON recipes)
# SCRAPER_SITE_USERNAME=your-user
# SCRAPER_SITE_PASSWORD=your-password
